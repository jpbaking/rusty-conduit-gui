{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rusty Conduit GUI",
  "version": "0.1.0",
  "identifier": "io.github.rusty-conduit-gui",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "copyright": "Copyright (c) 2026, Joseph Baking",
    "license": "BSD-3-Clause",
    "shortDescription": "Desktop shell for Rusty Conduit GUI",
    "longDescription": "Desktop shell for Rusty Conduit GUI: Tauri v2 adapter over the conduit crates.",
    "linux": {
      "deb": {
        "section": "net"
      },
      "rpm": {},
      "appimage": {}
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/nsis-hooks.nsh"
      },
      "wix": {
        "upgradeCode": "170EC6F2-0F3E-494D-8108-CD16C7097A20"
      }
    }
  }
}
